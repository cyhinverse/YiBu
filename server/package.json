    "worker:notification": "cross-env NODE_ENV=production node src/workers/notification.worker.js",
    "worker:email": "cross-env NODE_ENV=production node src/workers/email.worker.js",
    "worker:media": "cross-env NODE_ENV=production node src/workers/media.worker.js",
    "seed": "cross-env NODE_ENV=development node scripts/seed.js",
    "seed:drop": "cross-env NODE_ENV=development node scripts/seed.js --drop",
    "hashtags:sync": "cross-env NODE_ENV=development node scripts/sync-hashtags.js",
    "hashtags:sync:prune": "cross-env NODE_ENV=development node scripts/sync-hashtags.js --prune"
