# Docker Compose reads variables from this repo root `.env` automatically.
# Copy this file to `.env` and fill in values. Do NOT commit `.env`.

# Cloudinary (required for avatar/cover uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: backend secrets (Docker defaults exist, but you should override in real deployments)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional: extra protection when hashing refresh tokens in DB (recommended)
# NOTE: set once before issuing tokens; changing this later will invalidate all existing sessions.
REFRESH_TOKEN_PEPPER=

# Optional: Express trust proxy (recommended in production behind reverse proxy/load balancer)
# Examples: 1, true, false, "loopback"
TRUST_PROXY=1

# Optional: email (for password reset/notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Optional: only for local/dev with self-signed certs. NEVER enable in production.
EMAIL_ALLOW_INSECURE_TLS=false
